generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Profiles ──────────────────────────────────────────────────────────────────
// Dual purpose: email whitelist (admin pre-creates with just email, is_registered=false)
// and personal data store (user fills in after signing up, is_registered=true).
// The Supabase auth trigger updates the pre-created row on signup instead of inserting.

model Profile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @default("")
  email         String   @unique
  rut           String?
  phone         String?
  role          UserRole @default(member)
  avatar_url    String?
  is_registered Boolean  @default(false)
  created_at    DateTime @default(now())

  // Medical / emergency info — filled in by the user for aviso forms
  blood_type         String?
  allergies          String?
  medications        String?
  medical_conditions String?
  has_first_aid      Boolean @default(false)
  emergency_contact  String?
  emergency_phone    String?

  // Membership status — null or a past date means not an active member.
  // Computed on read (profile.membership_expires_at > now()), never a stored boolean.
  membership_expires_at DateTime?

  avisos          Aviso[]
  inscripciones   Inscripcion[]
  ayudantias      Ayudantia[]
  received_points CoursePoints[] @relation("recipient")
  awarded_points  CoursePoints[] @relation("awarder")
  custodio_pools  InventoryPool[] @relation("custodian")
  loan_requests   LoanRequest[]

  @@map("profiles")
}

enum UserRole {
  admin
  coordinador
  custodio
  member
}

// ── Avisos (exit notices) ─────────────────────────────────────────────────────

model Aviso {
  id                     Int         @id @default(autoincrement())
  created_by             String      @db.Uuid
  title                  String      @default("")
  status                 AvisoStatus @default(draft)
  tipo                   AvisoTipo   @default(largo)
  form_data              Json        @default("{}")
  location               String?
  activity_date          DateTime?
  activity_type          String?
  participant_names_text String?
  submitted_at           DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  profile       Profile       @relation(fields: [created_by], references: [id], onDelete: Cascade)
  loan_requests LoanRequest[]

  @@map("avisos")
}

enum AvisoStatus {
  draft
  submitted
  archived
}

enum AvisoTipo {
  rapido
  largo
}

// ── Activities ────────────────────────────────────────────────────────────────

model Activity {
  id                        Int      @id @default(autoincrement())
  name                      String   @unique
  equipment_recommendations Json?
  created_at                DateTime @default(now())

  @@map("activities")
}

// ── Equipment ─────────────────────────────────────────────────────────────────

model EquipmentItem {
  id       Int     @id @default(autoincrement())
  category String
  name     String
  active   Boolean @default(true)

  @@map("equipment_items")
}

// ── Rescue bodies (default contact list for the aviso's emergency section) ────

model RescueBody {
  id              Int     @id @default(autoincrement())
  nombre          String
  telefono        String
  default_incluir Boolean @default(false)
  order_index     Int     @default(0)

  @@map("rescue_bodies")
}

// ── Basic form autocomplete options ──────────────────────────────────────────

model BasicFormOption {
  id    Int    @id @default(autoincrement())
  type  String
  value String

  @@unique([type, value])
  @@map("basic_form_options")
}

// ── Supuestos (assumption bank) ───────────────────────────────────────────────

model Supuesto {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  categoria    String
  supuesto     String
  tramos       String[]
  actividades  String[]
  dificultades String[]
  estab_prob   String?
  estab_expo   String?
  mitigacion   String?
  senal        String?
  regla        String?

  @@map("supuestos")
}

// ── Risk management options ───────────────────────────────────────────────────

model RiskOption {
  id          Int     @id @default(autoincrement())
  key         String
  label       String
  type        String
  probability String?
  impact      String?

  @@map("risk_options")
}

// ── Talleres (workshop catalog) ───────────────────────────────────────────────

model Taller {
  id                      Int          @id @default(autoincrement())
  name                    String
  description             String       @default("")
  branch                  TallerBranch
  level                   TallerLevel
  order_index             Int
  prerequisite_taller_ids Int[]        @default([])
  content_outline         Json?

  // Curriculum fields (from Excel ficha template)
  objetivo              String?
  contenidos            String?
  habilidades           String?
  equipo_personal       String?
  equipo_recomendado    String?
  equipo_cau            String?
  evaluacion_metodo     String?
  lugar_tipico          String?
  condiciones_lugar     String?
  requisitos_personales String?
  observaciones         String?
  rutas_posibles        String?
  bibliografia          String?
  prueba_convalidacion  String?
  horas_clases          Float?
  horas_practica        Float?
  horas_evaluacion      Float?
  dias_terreno          Float?
  dias_traslado         Float?

  ediciones EdicionTaller[]

  @@unique([name, branch])
  @@map("talleres")
}

enum TallerBranch {
  base
  nieve_hielo
  roca
}

enum TallerLevel {
  introductorio
  intermedio
  intermedio_avanzado
  avanzado
}

// ── EdicionTaller (specific instance of a workshop) ──────────────────────────

model EdicionTaller {
  id                  Int           @id @default(autoincrement())
  taller_id           Int
  name                String
  start_date          DateTime?
  end_date            DateTime?
  capacity            Int           @default(20)
  max_ayudantes       Int           @default(0)
  price               Decimal?      @db.Decimal(10, 2)
  price_student       Decimal?      @db.Decimal(10, 2)
  status              EdicionStatus @default(planificada)
  enrollment_open     Boolean       @default(false)
  enrollment_opens_at DateTime?
  required_points     Int           @default(0)
  profesor            String?
  fecha_clases        String?
  fecha_salida        String?

  taller        Taller         @relation(fields: [taller_id], references: [id])
  inscripciones Inscripcion[]
  ayudantias    Ayudantia[]
  course_points CoursePoints[]

  @@unique([taller_id, name])
  @@map("ediciones_taller")
}

enum EdicionStatus {
  planificada
  inscripciones_abiertas
  en_curso
  finalizada
  cancelada
}

// ── Inscripcion (member applying to / enrolled in an EdicionTaller) ───────────

model Inscripcion {
  id                      Int               @id @default(autoincrement())
  edicion_id              Int
  user_id                 String            @db.Uuid
  status                  InscripcionStatus @default(postulando)
  aprobado                Boolean?
  rezagado                Boolean           @default(false)
  pago_recibido           Boolean           @default(false)
  grupo_sanguineo         String?
  alergias                String?
  medicamentos            String?
  condiciones_especiales  String?
  tiene_primeros_auxilios Boolean           @default(false)
  notas_coordinador       String?
  inscrito_at             DateTime          @default(now())
  aprobado_at             DateTime?

  edicion EdicionTaller @relation(fields: [edicion_id], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([edicion_id, user_id])
  @@map("inscripciones")
}

enum InscripcionStatus {
  postulando
  aceptado
  en_lista
  rechazado
  no_asiste
  completado
  reprobado
  retirado
  rezagado
}

// ── Ayudantia (experienced member helping teach an edition) ───────────────────

model Ayudantia {
  id               Int           @id @default(autoincrement())
  edicion_id       Int
  user_id          String        @db.Uuid
  seleccionado     Boolean?                    // null=pending, true=selected, false=rejected
  asistio          Boolean?                    // post-course attendance
  puntos_otorgados Boolean       @default(false)
  signed_up_at     DateTime      @default(now())

  edicion EdicionTaller @relation(fields: [edicion_id], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([edicion_id, user_id])
  @@map("ayudantias")
}

// ── Checklists (wikiexplora equipment checklists by route type) ───────────────

model Checklist {
  id    Int    @id @default(autoincrement())
  key   String @unique
  name  String
  items Json

  @@map("checklists")
}

// ── Course points (earned by ayudantias, awarded by coordinadores) ────────────

model CoursePoints {
  id          Int            @id @default(autoincrement())
  user_id     String         @db.Uuid
  edicion_id  Int?
  points      Int            @default(1)
  awarded_by  String         @db.Uuid
  description String?
  earned_at   DateTime       @default(now())
  expires_at  DateTime

  recipient Profile        @relation("recipient", fields: [user_id], references: [id], onDelete: Cascade)
  awarder   Profile        @relation("awarder", fields: [awarded_by], references: [id])
  edicion   EdicionTaller? @relation(fields: [edicion_id], references: [id])

  @@map("course_points")
}

// ── Equipo Club (lending) ──────────────────────────────────────────────────────
// Replaces an external Google Form + Sheet + Apps Script system. "Disponible" and
// "Prestados" are deliberately NOT stored columns — they're always computed from
// InventoryItem quantities + active LoanItem reservations (see src/lib/inventory.ts),
// which is the core fix for the old sheet's manually-edited, frequently-stale counts.

model InventoryPool {
  id           Int      @id @default(autoincrement())
  key          String   @unique // stable code, e.g. "equipo_club" — not the display name
  name         String
  custodian_id String?  @db.Uuid
  requisitos   String? // free text, e.g. "Adjuntar aviso de salida"
  created_at   DateTime @default(now())

  custodian Profile?        @relation("custodian", fields: [custodian_id], references: [id])
  items     InventoryItem[]
  loans     LoanRequest[]

  @@map("inventory_pools")
}

model InventoryItem {
  id            Int           @id @default(autoincrement())
  pool_id       Int
  uso           String // category: "Nieve", "Hielo", "Cuerdas", etc. — free text, custodio-managed
  descripcion   String
  cantidad      Int // total units owned
  estado        ItemCondition @default(bueno)
  en_inspeccion Int           @default(0) // units out for repair/inspection
  fecha_compra  DateTime?
  observaciones String?
  active        Boolean       @default(true) // soft-delete only — never hard-deleted if it has loan history
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  pool       InventoryPool @relation(fields: [pool_id], references: [id])
  loan_items LoanItem[]

  @@index([pool_id])
  @@map("inventory_items")
}

enum ItemCondition {
  nuevo
  bueno
  con_uso
  gastado
  roto
}

model LoanRequest {
  id      Int    @id @default(autoincrement())
  pool_id Int
  user_id String @db.Uuid // borrower

  // Required at the application layer for new member-created requests; nullable at
  // the DB level only so historical/seeded loans (which predate this system and have
  // no real aviso) can exist without one.
  aviso_id Int?

  status        LoanStatus @default(pendiente)
  cancel_reason String? // replaces the old sheet's separate No Vigente/Fuera de Plazo/Suspendido/Cancelación flags

  return_due_date DateTime // validated against MAX_LOAN_DURATION_DAYS at creation

  // Pickup photo: captured by the custodio at the physical handoff (deliver action).
  pickup_photo_base64 String?

  // Return photo: captured by the BORROWER before physically returning the item
  // (self-service "foto-devolucion" action) — the custodio's return action requires
  // this to already be set rather than supplying it themselves.
  return_photo_base64     String?
  return_photo_uploaded_at DateTime?

  notas_custodio String?

  requested_at DateTime  @default(now())
  decided_at   DateTime?
  delivered_at DateTime?
  returned_at  DateTime?

  pool  InventoryPool @relation(fields: [pool_id], references: [id])
  user  Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  aviso Aviso?         @relation(fields: [aviso_id], references: [id])
  items LoanItem[]

  @@index([pool_id, status])
  @@index([user_id])
  @@map("loan_requests")
}

enum LoanStatus {
  pendiente
  aprobado
  entregado
  devuelto
  rechazado
  cancelado
}

model LoanItem {
  id                Int @id @default(autoincrement())
  loan_request_id   Int
  inventory_item_id Int
  quantity          Int

  loan_request   LoanRequest   @relation(fields: [loan_request_id], references: [id], onDelete: Cascade)
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id])

  @@unique([loan_request_id, inventory_item_id])
  @@map("loan_items")
}

