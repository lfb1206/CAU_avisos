generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Profiles ──────────────────────────────────────────────────────────────────
// Dual purpose: email whitelist (admin pre-creates with just email, is_registered=false)
// and personal data store (user fills in after signing up, is_registered=true).
// The Supabase auth trigger updates the pre-created row on signup instead of inserting.

model Profile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @default("")
  email         String   @unique
  rut           String?
  phone         String?
  role          UserRole @default(member)
  avatar_url    String?
  is_registered Boolean  @default(false)
  created_at    DateTime @default(now())

  // Medical / emergency info — filled in by the user for aviso forms
  blood_type         String?
  allergies          String?
  medications        String?
  medical_conditions String?
  has_first_aid      Boolean @default(false)
  emergency_contact  String?
  emergency_phone    String?

  avisos                Aviso[]
  inscripciones         Inscripcion[]
  ayudantias            Ayudantia[]
  coordinadas_ediciones EdicionTaller[] @relation("coordinador_edicion")
  received_points       CoursePoints[]  @relation("recipient")
  awarded_points        CoursePoints[]  @relation("awarder")

  @@map("profiles")
}

enum UserRole {
  admin
  coordinador
  member
}

// ── Avisos (exit notices) ─────────────────────────────────────────────────────

model Aviso {
  id                     Int         @id @default(autoincrement())
  created_by             String      @db.Uuid
  title                  String      @default("")
  status                 AvisoStatus @default(draft)
  tipo                   AvisoTipo   @default(largo)
  form_data              Json        @default("{}")
  location               String?
  activity_date          DateTime?
  activity_type          String?
  participant_names_text String?
  submitted_at           DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  profile Profile @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@map("avisos")
}

enum AvisoStatus {
  draft
  submitted
  archived
}

enum AvisoTipo {
  rapido
  largo
}

// ── Activities ────────────────────────────────────────────────────────────────

model Activity {
  id                        Int      @id @default(autoincrement())
  name                      String   @unique
  equipment_recommendations Json?
  created_at                DateTime @default(now())

  @@map("activities")
}

// ── Equipment ─────────────────────────────────────────────────────────────────

model EquipmentItem {
  id       Int     @id @default(autoincrement())
  category String
  name     String
  active   Boolean @default(true)

  @@map("equipment_items")
}

// ── Basic form autocomplete options ──────────────────────────────────────────

model BasicFormOption {
  id    Int    @id @default(autoincrement())
  type  String
  value String

  @@unique([type, value])
  @@map("basic_form_options")
}

// ── Supuestos (assumption bank) ───────────────────────────────────────────────

model Supuesto {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  categoria    String
  supuesto     String
  tramos       String[]
  actividades  String[]
  dificultades String[]
  estab_prob   String?
  estab_expo   String?
  mitigacion   String?
  senal        String?
  regla        String?

  @@map("supuestos")
}

// ── Risk management options ───────────────────────────────────────────────────

model RiskOption {
  id          Int     @id @default(autoincrement())
  key         String
  label       String
  type        String
  probability String?
  impact      String?

  @@map("risk_options")
}

// ── Talleres (workshop catalog) ───────────────────────────────────────────────

model Taller {
  id                      Int          @id @default(autoincrement())
  name                    String
  description             String       @default("")
  branch                  TallerBranch
  level                   TallerLevel
  order_index             Int
  prerequisite_taller_ids Int[]        @default([])
  content_outline         Json?

  ediciones EdicionTaller[]

  @@unique([name, branch])
  @@map("talleres")
}

enum TallerBranch {
  base
  nieve_hielo
  roca
}

enum TallerLevel {
  introductorio
  intermedio
  intermedio_avanzado
  avanzado
}

// ── EdicionTaller (specific instance of a workshop) ──────────────────────────

model EdicionTaller {
  id                  Int           @id @default(autoincrement())
  taller_id           Int
  name                String
  start_date          DateTime?
  end_date            DateTime?
  capacity            Int           @default(20)
  max_ayudantes       Int           @default(0)
  price               Decimal?      @db.Decimal(10, 2)
  status              EdicionStatus @default(planificada)
  enrollment_open     Boolean       @default(false)
  enrollment_opens_at DateTime?
  required_points     Int           @default(0)
  coordinador_id      String?       @db.Uuid
  location            String?
  notas               String?

  taller        Taller         @relation(fields: [taller_id], references: [id])
  coordinador   Profile?       @relation("coordinador_edicion", fields: [coordinador_id], references: [id])
  inscripciones Inscripcion[]
  ayudantias    Ayudantia[]
  course_points CoursePoints[]

  @@unique([taller_id, name])
  @@map("ediciones_taller")
}

enum EdicionStatus {
  planificada
  inscripciones_abiertas
  en_curso
  finalizada
  cancelada
}

// ── Inscripcion (member applying to / enrolled in an EdicionTaller) ───────────

model Inscripcion {
  id                      Int               @id @default(autoincrement())
  edicion_id              Int
  user_id                 String            @db.Uuid
  status                  InscripcionStatus @default(postulando)
  aprobado                Boolean?
  rezagado                Boolean           @default(false)
  pago_recibido           Boolean           @default(false)
  grupo_sanguineo         String?
  alergias                String?
  medicamentos            String?
  condiciones_especiales  String?
  tiene_primeros_auxilios Boolean           @default(false)
  notas_coordinador       String?
  inscrito_at             DateTime          @default(now())
  aprobado_at             DateTime?

  edicion EdicionTaller @relation(fields: [edicion_id], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([edicion_id, user_id])
  @@map("inscripciones")
}

enum InscripcionStatus {
  postulando
  aceptado
  en_lista
  rechazado
  no_asiste
  completado
  reprobado
  retirado
  rezagado
}

// ── Ayudantia (experienced member helping teach an edition) ───────────────────

model Ayudantia {
  id               Int           @id @default(autoincrement())
  edicion_id       Int
  user_id          String        @db.Uuid
  asistio          Boolean?
  puntos_otorgados Boolean       @default(false)
  signed_up_at     DateTime      @default(now())

  edicion EdicionTaller @relation(fields: [edicion_id], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([edicion_id, user_id])
  @@map("ayudantias")
}

// ── Course points (earned by ayudantias, awarded by coordinadores) ────────────

model CoursePoints {
  id          Int            @id @default(autoincrement())
  user_id     String         @db.Uuid
  edicion_id  Int?
  points      Int            @default(1)
  awarded_by  String         @db.Uuid
  description String?
  earned_at   DateTime       @default(now())
  expires_at  DateTime

  recipient Profile        @relation("recipient", fields: [user_id], references: [id], onDelete: Cascade)
  awarder   Profile        @relation("awarder", fields: [awarded_by], references: [id])
  edicion   EdicionTaller? @relation(fields: [edicion_id], references: [id])

  @@map("course_points")
}

